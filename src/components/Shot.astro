---
// An app screenshot in a Mac window, light or dark to match the visitor's system.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
    name: string;            // e.g. "read" → read-light.png and read-dark.png
    alt: string;
    eager?: boolean;
    sizes?: string;
    class?: string;
}

const { name, alt, eager = false, sizes = '(min-width: 1024px) 58rem, 100vw', class: className } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const pick = (mode: string) => {
    const file = files[`../assets/shots/${name}-${mode}.png`];
    if (!file) throw new Error(`Missing screenshot ${name}-${mode}.png`);
    return file.default;
};
const widths = [720, 1280, 1920, 2560];
const build = async (src: ImageMetadata, format: 'avif' | 'webp') => (await getImage({ src, widths, format, sizes })).srcSet.attribute;

const light = pick('light');
const dark = pick('dark');
const fallback = await getImage({ src: light, width: 1280, format: 'webp' });
---

<picture class={className}>
    <source media="(prefers-color-scheme: dark)" type="image/avif" srcset={await build(dark, 'avif')} sizes={sizes} />
    <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={await build(dark, 'webp')} sizes={sizes} />
    <source type="image/avif" srcset={await build(light, 'avif')} sizes={sizes} />
    <source type="image/webp" srcset={await build(light, 'webp')} sizes={sizes} />
    <img
        src={fallback.src}
        alt={alt}
        width={light.width / 2}
        height={light.height / 2}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        class="mac-window"
    />
</picture>
