---
import Article from '../components/Article.astro';

// Each release adds src/changelog/<version>.md (written by the app's release script).
type Entry = { frontmatter: { version: string; build: number; date: string }; Content: any };
const entries = Object.values(import.meta.glob<Entry>('../changelog/*.md', { eager: true }))
    .sort((a, b) => b.frontmatter.build - a.frontmatter.build);
const longDate = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Article title="Changelog · Stillread" heading="Changelog" eyebrow="What's new" description="Every Stillread release and what changed.">
    {entries.length === 0 ? (
        <p class="text-ink-soft">The first release is on its way.</p>
    ) : (
        entries.map(({ frontmatter, Content }) => (
            <section class="border-b border-rule pb-10 mb-10 last:border-0">
                <h2 id={`v${frontmatter.version}`}>Stillread {frontmatter.version}</h2>
                <p class="font-sans text-sm text-ink-faint">{longDate(frontmatter.date)}</p>
                <Content />
            </section>
        ))
    )}
</Article>
