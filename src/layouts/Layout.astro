---
import '../styles/global.css';
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { fathomSite } from '../config';

interface Props {
    title: string;
    description: string;
    /** Pages like 404 shouldn't be indexed. */
    noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
const nav = [
    { href: '/#features', label: 'Features' },
    { href: '/#pricing', label: 'Pricing' },
    { href: '/support', label: 'Support' },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex" />}
        <meta name="theme-color" content="#faf6ee" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#1e1e20" media="(prefers-color-scheme: dark)" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Stillread" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Stillread: a calm Markdown reader for the Mac" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="icon" href="/favicon.png" type="image/png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        {fathomSite && <script src="https://cdn.usefathom.com/script.js" data-site={fathomSite} defer></script>}
    </head>
    <body class="min-h-screen bg-paper font-serif text-ink antialiased">
        <a href="#main" class="focus-ring sr-only rounded bg-paper px-3 py-2 font-sans text-sm focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50">Skip to content</a>

        <header class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 pt-5 sm:px-8 sm:pt-7">
            <a href="/" class="focus-ring flex items-center gap-2.5 rounded-md">
                <Image src={icon} alt="" width={40} height={40} class="size-10 -my-1" />
                <span class="text-lg font-semibold tracking-tight">Stillread</span>
            </a>
            <nav aria-label="Main" class="flex gap-4 font-sans text-sm text-ink-soft sm:gap-6">
                {nav.map(({ href, label }) => (
                    <a href={href} class:list={['focus-ring rounded px-0.5 hover:text-ink', label === 'Features' && 'hidden sm:inline']}>{label}</a>
                ))}
            </nav>
        </header>

        <main id="main">
            <slot />
        </main>

        <footer class="mx-auto max-w-5xl px-4 pt-6 pb-12 sm:px-8">
            <div class="flex flex-col gap-4 border-t border-rule pt-8 font-sans text-sm text-ink-faint sm:flex-row sm:items-center sm:justify-between">
                <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
                    <a href="/support" class="focus-ring rounded hover:text-ink">Support</a>
                    <a href="/privacy" class="focus-ring rounded hover:text-ink">Privacy</a>
                    <a href="/terms" class="focus-ring rounded hover:text-ink">Terms</a>
                    <a href="/refunds" class="focus-ring rounded hover:text-ink">Refunds</a>
                </nav>
                <p>© {year} <a href="https://cascadia.digital" class="focus-ring rounded hover:text-ink">Cascadia Digital Inc.</a></p>
            </div>
        </footer>
    </body>
</html>
