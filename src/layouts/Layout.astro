---
import '../styles/global.css';
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { fathomSite, sale } from '../config';

interface Props {
    title: string;
    description: string;
    /** Pages like 404 shouldn't be indexed. */
    noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
// New filename whenever the image changes, so cached link previews refresh.
const ogImage = new URL('/og-v2.png', Astro.site);
const ogAlt = 'Stillread: a calm place to read Markdown on your Mac. Download for Mac; free to read, Editing $9.99 once.';
const year = new Date().getFullYear();
const nav = [
    { href: '/#features', label: 'Features' },
    { href: '/#pricing', label: 'Pricing' },
    { href: '/support', label: 'Support' },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex" />}
        <meta name="theme-color" content="#faf6ee" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#1e1e20" media="(prefers-color-scheme: dark)" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Stillread" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={ogAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogAlt} />
        <link rel="icon" href="/favicon.png" type="image/png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <script is:inline define:vars={{ start: sale.start, end: sale.end }}>
            // Turn the sale on before the page paints, so nothing flashes or shifts.
            // Everything marked data-sale-only stays hidden unless this sets data-sale="on".
            try {
                var mode = new URLSearchParams(location.search).get('sale');
                var now = Date.now();
                var on = mode === 'preview' || (mode !== 'off' && now >= Date.parse(start) && now < Date.parse(end));
                if (on) document.documentElement.setAttribute('data-sale', 'on');
            } catch (_) {}
        </script>
        {fathomSite && <script src="https://cdn.usefathom.com/script.js" data-site={fathomSite} defer></script>}
        {fathomSite && (
            <script is:inline>
                // Count clicks on links marked data-fathom-event. It never stops or delays the link,
                // and does nothing when Fathom isn't loaded (blocked, or analytics off).
                document.addEventListener('click', function (e) {
                    var link = e.target instanceof Element && e.target.closest('[data-fathom-event]');
                    if (!link) return;
                    try {
                        if (window.fathom && typeof window.fathom.trackEvent === 'function') {
                            window.fathom.trackEvent(link.getAttribute('data-fathom-event'));
                        }
                    } catch (_) {}
                });
            </script>
        )}
    </head>
    <body class="min-h-screen bg-paper font-serif text-ink antialiased">
        <a href="#main" class="focus-ring sr-only rounded bg-paper px-3 py-2 font-sans text-sm focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50">Skip to content</a>

        <aside data-sale-only aria-label="Black Friday sale" class="border-b border-rule bg-water/40 font-sans text-sm text-ink">
            <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-3 gap-y-1.5 px-4 py-2.5 text-center sm:px-8">
                <p>
                    <span class="font-semibold">Black Friday:</span> Editing is half price with code
                    <code class="rounded bg-paper px-1.5 py-0.5 font-mono text-[0.9em] font-semibold tracking-wide">{sale.code}</code>,
                    through {sale.ends}.
                </p>
                <span class="flex items-center gap-3">
                    <button type="button" data-copy-code={sale.code} class="focus-ring cursor-pointer rounded-full px-3 py-0.5 ring-1 ring-water-deep hover:bg-paper/60">Copy code</button>
                    <a href="/#pricing" class="focus-ring rounded text-water-ink underline underline-offset-3 hover:text-ink">See pricing</a>
                </span>
                <span class="sr-only" role="status" data-copy-status></span>
            </div>
        </aside>

        <header class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 pt-5 sm:px-8 sm:pt-7">
            <a href="/" class="focus-ring flex items-center gap-2.5 rounded-md">
                <Image src={icon} alt="" width={40} height={40} class="size-10 -my-1" />
                <span class="text-lg font-semibold tracking-tight">Stillread</span>
            </a>
            <nav aria-label="Main" class="flex gap-4 font-sans text-sm text-ink-soft sm:gap-6">
                {nav.map(({ href, label }) => (
                    <a href={href} class:list={['focus-ring rounded px-0.5 hover:text-ink', label === 'Features' && 'hidden sm:inline']}>{label}</a>
                ))}
            </nav>
        </header>

        <main id="main">
            <slot />
        </main>

        <footer class="mx-auto max-w-5xl px-4 pt-6 pb-12 sm:px-8">
            <div class="flex flex-col gap-4 border-t border-rule pt-8 font-sans text-sm text-ink-faint sm:flex-row sm:items-center sm:justify-between">
                <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
                    <a href="/support" class="focus-ring rounded hover:text-ink">Support</a>
                    <a href="/changelog" class="focus-ring rounded hover:text-ink">Changelog</a>
                    <a href="/privacy" class="focus-ring rounded hover:text-ink">Privacy</a>
                    <a href="/terms" class="focus-ring rounded hover:text-ink">Terms</a>
                    <a href="/refunds" class="focus-ring rounded hover:text-ink">Refunds</a>
                </nav>
                <p>© {year} <a href="https://cascadia.digital" class="focus-ring rounded hover:text-ink">Cascadia Digital Inc.</a></p>
            </div>
        </footer>
        <script is:inline>
            // Copy the sale code. The button only shows while the sale is on.
            document.addEventListener('click', function (e) {
                var button = e.target instanceof Element && e.target.closest('[data-copy-code]');
                if (!button || !navigator.clipboard) return;
                navigator.clipboard.writeText(button.getAttribute('data-copy-code')).then(function () {
                    var label = button.textContent;
                    button.textContent = 'Copied';
                    var status = document.querySelector('[data-copy-status]');
                    if (status) status.textContent = 'Code copied';
                    setTimeout(function () { button.textContent = label; if (status) status.textContent = ''; }, 2000);
                });
            });
        </script>
    </body>
</html>
